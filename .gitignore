# .gitignore -- Interferosim
# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
# Sphinx build output
docs/sphinx/_build/
# Jupyter
.ipynb_checkpoints/
# LaTeX build files (docs/)
docs/*.aux
docs/*.log
docs/*.toc
docs/*.lof
docs/*.lot
docs/*.out
docs/*.idx
docs/*.ilg
docs/*.ind
docs/*.ist
docs/*.bbl
docs/*.bcf
docs/*.blg
docs/*.run.xml
docs/*.synctex.gz
docs/*.fls
docs/*.fdb_latexmk
docs/*.glo
docs/*.gls
docs/*.glg
docs/*.acn
docs/*.acr
docs/*.alg
docs/*.abk
docs/*.abks
docs/*.Abkuerzungen
# Large local archives that are not part of the repository
*.zip
*.tar.gz
# Built PDFs (generated from the LaTeX sources)
docs/*.pdf
# Images in docs/images: only project-made figures are published; third-party
# images stay local until their licences are clarified
docs/images/*
!docs/images/.gitkeep
!docs/images/sky_demo_overview.png
!docs/images/sky_gallery.png
!docs/images/instrument_beams.png
!docs/images/instrument_arrays.png
!docs/images/cyga_baseline.png
!docs/images/array_geometry.tex
!docs/images/array_geometry.pdf
!docs/images/array_geometry.png
!docs/images/b210_blockdiagram.tex
!docs/images/b210_blockdiagram.pdf
!docs/images/b210_blockdiagram.png
!docs/images/signal_check.png
!docs/images/obs_uv_coverage.png
!docs/images/obs_cyga_track.png
!docs/images/obs_sun_transit.png
!docs/images/obs_track_symmetry.png
# Scratch output of the examples (CLI demo map, notebook 01) and scratch notebooks
/*.png
notebooks/my_example_sky.json
notebooks/sim_output/
notebooks/Untitled*.ipynb
# Local backup copies (e.g. a notebook saved before an update)
*.bak
# Generated API documentation (doxygen Doxyfile)
docs/api/
